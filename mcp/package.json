{
  "name": "tdcv2-mcp",
  "version": "0.1.3",
  "description": "MCP server for TDCv2: agents write a .tdc config, check it and generate test data locally — deterministic, same seed, same bytes.",
  "type": "module",
  "bin": {
    "tdcv2-mcp": "src/cli.mjs"
  },
  "files": [
    "src",
    "skill",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node scripts/copy-skill.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "test-data",
    "tdcv2",
    "fixtures",
    "synthetic-data",
    "deterministic"
  ],
  "author": "Nikolai Liapin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "tdcv2": "0.3.3",
    "zod": "4.6.5"
  },
  "mcpName": "io.github.NickLiapin/tdcv2",
  "homepage": "https://github.com/NickLiapin/tdcv2-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickLiapin/tdcv2-agents.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/NickLiapin/tdcv2-agents/issues"
  }
}
